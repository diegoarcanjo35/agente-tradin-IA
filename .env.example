# Copy this file to .env and fill in values as needed.
# NEVER commit the real .env file. It is already listed in .gitignore.

# REPLAY (default, no credentials needed) | PAPER_LOCAL | PAPER_LIVE | BYBIT_DEMO
# PAPER_LIVE (Fase 2): real Bybit Demo market data via public endpoints only
# (no BYBIT_API_KEY/SECRET needed), execution stays entirely local/simulated
# -- never reaches the exchange's order-management endpoints.
MODE=REPLAY

# Only used in BYBIT_DEMO mode. Create a key on the Bybit DEMO TRADING
# environment (not mainnet). The key must NOT have withdrawal permission -
# request "Read" + "Trade" only, and restrict by IP if your plan supports it.
# See docs/OPERACAO_DEMO.md for step-by-step instructions.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Must remain a Bybit Demo Trading host (Testnet is not supported this
# phase -- see docs/OPERACAO_DEMO.md). The app refuses to start otherwise.
BYBIT_BASE_URL=https://api-demo.bybit.com
BYBIT_WS_URL=wss://stream-demo.bybit.com

DATABASE_URL=sqlite:///./agente_trader.db

SYMBOL=BTCUSDT

# Market data polling cadence. Conservative default for BYBIT_DEMO (a 1m
# timeframe never needs sub-second polling); REPLAY/PAPER_LOCAL use a much
# faster interval since they never touch a real rate-limited API.
BYBIT_POLL_INTERVAL_SECONDS=5.0
REPLAY_POLL_INTERVAL_SECONDS=0.02

# Optional: primeiro-boot do provider de dados de mercado (correção v1.5 #1
# / v1.6). Sem cursor persistido, o provider por padrão ancora no candle
# fechado mais recente (janela única, limitada). Se definido, ancora exatamente
# neste instante em vez disso. Formato: ISO 8601. Timezone explícito é
# recomendado ('Z' = UTC, ou um offset como '-03:00'); um valor sem timezone é
# aceito e interpretado como UTC. Um valor sintaticamente inválido impede a
# inicialização com erro claro em português -- nunca falha só durante o
# primeiro polling. Ver docs/OPERACAO_DEMO.md.
# MARKET_DATA_INITIAL_START=2024-06-01T12:00:00Z

# Fase 2, item 7.4: reconciliação periódica (não só no startup/erro).
# Se a reconciliação ficar mais atrasada que RECONCILIATION_MAX_DELAY_SECONDS,
# novas ABERTURAS de posição são bloqueadas (fechamentos/reduções continuam
# permitidos) até uma reconciliação recente. Ver docs/OPERACAO_DEMO.md.
RECONCILIATION_INTERVAL_SECONDS=300.0
RECONCILIATION_MAX_DELAY_SECONDS=900.0

# Risk Engine limits (conservative defaults shown; edit with care)
RISK_MAX_POSITION_USD=50.0
RISK_MAX_CONCURRENT_POSITIONS=1
RISK_MAX_DAILY_LOSS_USD=25.0
RISK_MAX_TOTAL_EXPOSURE_USD=50.0
RISK_COOLDOWN_AFTER_LOSSES=3
RISK_COOLDOWN_MINUTES=30
RISK_MAX_DATA_STALENESS_SECONDS=30
RISK_MAX_API_FAILURES=5
RISK_MAX_CLOCK_DRIFT_SECONDS=5.0

# AI Shadow Agent (observation-only, no execution authority). Leave the key
# blank to run with the deterministic SimulatedProvider (default, no network).
AI_SHADOW_ENABLED_DEFAULT=true
AI_PROVIDER_API_KEY=
AI_TIMEOUT_SECONDS=8.0
AI_MAX_RESPONSE_CHARS=4000

LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# Start the server ONLY via the official launcher: `python -m app.run`.
# It is the sole code path that actually passes API_HOST/API_PORT to
# uvicorn -- a raw `uvicorn app.api.main:app --host 0.0.0.0` bypasses this
# validation entirely. Keep API_HOST local; the launcher refuses to start
# bound to a non-local address unless API_ALLOW_EXTERNAL_BIND=true.
API_HOST=127.0.0.1
API_PORT=8000
API_ALLOW_EXTERNAL_BIND=false

# Second, independent layer of protection for the kill-switch endpoints,
# regardless of how the server was actually started (see docs/SEGURANCA.md).
# Engaging the kill switch never requires this. Disengaging it does, UNLESS
# the request is local (127.0.0.1) -- leave blank for local-only operation.
CONTROL_API_TOKEN=

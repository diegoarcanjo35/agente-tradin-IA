# Copy this file to .env and fill in values as needed.
# NEVER commit the real .env file. It is already listed in .gitignore.

# REPLAY (default, no credentials needed) | PAPER_LOCAL | BYBIT_DEMO
MODE=REPLAY

# Only used in BYBIT_DEMO mode. Create a key on the Bybit DEMO TRADING
# environment (not mainnet). The key must NOT have withdrawal permission -
# request "Read" + "Trade" only, and restrict by IP if your plan supports it.
# See docs/OPERACAO_DEMO.md for step-by-step instructions.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Must remain a demo/testnet host. The app refuses to start otherwise.
BYBIT_BASE_URL=https://api-demo.bybit.com
BYBIT_WS_URL=wss://stream-demo.bybit.com

DATABASE_URL=sqlite:///./agente_trader.db

SYMBOL=BTCUSDT

# Risk Engine limits (conservative defaults shown; edit with care)
RISK_MAX_POSITION_USD=50.0
RISK_MAX_CONCURRENT_POSITIONS=1
RISK_MAX_DAILY_LOSS_USD=25.0
RISK_MAX_TOTAL_EXPOSURE_USD=50.0
RISK_COOLDOWN_AFTER_LOSSES=3
RISK_COOLDOWN_MINUTES=30
RISK_MAX_DATA_STALENESS_SECONDS=30
RISK_MAX_API_FAILURES=5
RISK_MAX_CLOCK_DRIFT_SECONDS=5.0

# AI Shadow Agent (observation-only, no execution authority). Leave the key
# blank to run with the deterministic SimulatedProvider (default, no network).
AI_SHADOW_ENABLED_DEFAULT=true
AI_PROVIDER_API_KEY=
AI_TIMEOUT_SECONDS=8.0
AI_MAX_RESPONSE_CHARS=4000

LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# The control API (kill switch engage/disengage) has NO authentication in
# this phase. Keep API_HOST local; the app refuses to start bound to a
# non-local address unless API_ALLOW_EXTERNAL_BIND=true is set explicitly.
API_HOST=127.0.0.1
API_ALLOW_EXTERNAL_BIND=false
